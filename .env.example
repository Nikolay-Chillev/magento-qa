# Copy to .env to override the defaults. All values are optional.
QA_BASE_URL=http://localhost:8080/
QA_MAILPIT_URL=http://localhost:8025/
QA_REQUEST_TIMEOUT=30
QA_WAIT_TIMEOUT=60
# Admin user for the REST API; defaults are the public ones of the Docker image.
QA_ADMIN_USERNAME=exampleuser
QA_ADMIN_PASSWORD=examplepassword123
